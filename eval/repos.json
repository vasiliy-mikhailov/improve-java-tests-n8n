{
  "synth": {
    "name": "synth",
    "synth": true,
    "repoUrl": "file:///data/eval/synth-origin",
    "repoBranch": "main",
    "scopeGlob": "src/main/java/**/*.java",
    "scopeLimit": 2,
    "maxIterations": 3,
    "prMode": "local",
    "timeoutMin": 45,
    "rules": {
      "post_clone": "read AGENTS.md to find out how to behave after cloning",
      "pre_pick": "create a separate branch per class named tests/improve-{file}",
      "pick_file": "don't touch UI classes (anything under src/main/java/com/example/ui/)",
      "write_test": "no reflection or introspection; JUnit 5 only; tests mirror the package under src/test/java",
      "check_changes": "good only if suite green and MAC improved",
      "make_pr": "read AGENTS.md to find out how to make the PR properly"
    },
    "maxMutantsPerFile": 8
  },
  "candidates": [
    {
      "name": "json-java",
      "repoUrl": "https://github.com/stleary/JSON-java",
      "repoBranch": "master",
      "scopeGlob": "src/main/java/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 60,
      "note": "Maven, JUnit 4, small — the fastest end-to-end smoke of the real path"
    },
    {
      "name": "commons-cli",
      "repoUrl": "https://github.com/apache/commons-cli",
      "repoBranch": "master",
      "scopeGlob": "src/main/java/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 60,
      "note": "Maven, JUnit 5, tiny test suite"
    },
    {
      "name": "commons-csv",
      "repoUrl": "https://github.com/apache/commons-csv",
      "repoBranch": "master",
      "scopeGlob": "src/main/java/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 60,
      "note": "Maven, JUnit 5, parser logic — mutation-rich"
    },
    {
      "name": "commons-codec",
      "repoUrl": "https://github.com/apache/commons-codec",
      "repoBranch": "master",
      "scopeGlob": "src/main/java/org/apache/commons/codec/binary/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 75,
      "note": "Maven, JUnit 5; scoped to one package to bound the run"
    },
    {
      "name": "commons-text",
      "repoUrl": "https://github.com/apache/commons-text",
      "repoBranch": "master",
      "scopeGlob": "src/main/java/org/apache/commons/text/similarity/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 75,
      "note": "Maven, JUnit 5; similarity algorithms are arithmetic-dense"
    },
    {
      "name": "jsoup",
      "repoUrl": "https://github.com/jhy/jsoup",
      "repoBranch": "master",
      "scopeGlob": "src/main/java/org/jsoup/helper/**/*.java,src/main/java/org/jsoup/internal/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 75,
      "note": "Maven, JUnit 5"
    },
    {
      "name": "json-path",
      "repoUrl": "https://github.com/json-path/JsonPath",
      "repoBranch": "master",
      "scopeGlob": "json-path/src/main/java/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 75,
      "note": "Maven multi-module — exercises module-scoped PIT (-pl)"
    },
    {
      "name": "jackson-core",
      "repoUrl": "https://github.com/FasterXML/jackson-core",
      "repoBranch": "2.x",
      "scopeGlob": "src/main/java/com/fasterxml/jackson/core/io/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 90,
      "note": "Maven, JUnit 5, large suite; scoped to one package"
    },
    {
      "name": "concurrency-limits",
      "repoUrl": "https://github.com/Netflix/concurrency-limits",
      "repoBranch": "master",
      "scopeGlob": "concurrency-limits-core/src/main/java/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 90,
      "note": "GRADLE multi-project, JUnit 4 — the Gradle path (D9)"
    },
    {
      "name": "moshi",
      "repoUrl": "https://github.com/square/moshi",
      "repoBranch": "master",
      "scopeGlob": "moshi/src/main/java/**/*.java",
      "scopeLimit": 1,
      "maxIterations": 2,
      "prMode": "local",
      "timeoutMin": 90,
      "note": "GRADLE multi-project, JUnit 4"
    }
  ]
