{
  "name": "improve-javascript-tests",
  "version": "1.0.0",
  "private": true,
  "description": "n8n pipeline in Docker that raises coverage, Stryker mutation score and MAC of any JS/TS repo",
  "scripts": {
    "test": "node --test sidecar/test/unit/*.test.js",
    "workflow": "node n8n/generate-workflows.mjs",
    "check": "node --test sidecar/test/unit/*.test.js && node n8n/generate-workflows.mjs",
    "test:model": "node --test --test-timeout=900000 sidecar/test/model/*.test.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1"
  }
}
