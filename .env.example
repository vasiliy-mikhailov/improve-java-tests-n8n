# ─── GitHub ─────────────────────────────────────────────────────────────────
# PAT with repo scope: clone private repos, push branches, open PRs.
GH_TOKEN=ghp_replace_me
GIT_USER_NAME=Improve Tests Bot
GIT_USER_EMAIL=bot@example.com

# ─── Target repo (teams: change these two lines and run) ────────────────────
REPO_URL=https://github.com/your-org/your-java-repo
REPO_BRANCH=main

# ─── Scope & loop policy ────────────────────────────────────────────────────
# Comma-separated globs of source files eligible for improvement. Java sources
# only; test sources and generated code are excluded automatically.
SCOPE_GLOB=**/src/main/java/**/*.java
# 0 = whole repo; N = stop after N files were processed (improved or given up).
# Start with 1 for a smoke test, then set 0 for a full-repo run.
SCOPE_LIMIT=1
# 0 = no limit for the repo.
MAX_ITERATIONS=0
# Surviving mutants shown to the model per round (NO_COVERAGE ones come first).
MAX_MUTANTS_PER_FILE=8
# Per-file improvement rounds: keep going until all of coverage/mutation/MAC stale or any degrades.
MAX_ROUNDS_PER_FILE=12
# Mutants handed to the model per round. 1 = write ONE test for the single most promising
# survivor, re-measure, repeat — small prompts compile far more reliably than a sprawling
# test aimed at a dozen mutants, and every kill is verified before the next is attempted.
MUTANTS_PER_ROUND=1
# ceiling on the wall-clock one unit may consume, however cheap each round is
UNIT_BUDGET_SEC=2400
# Pick attempts per file before it is settled as no_improvement.
MAX_ATTEMPTS_PER_FILE=3
# Diminishing returns: a round is always KEPT when it improves something, but a
# FURTHER round is only spent if the last one closed at least this share of the
# remaining MAC gap (0.05 = 5%) and gained at least this many MAC points. Guards
# against mutant tar pits — huge generated/DTO classes where each multi-minute
# round buys a fraction of a point. Set both to 0 for unconditional rounds. Both are
# automatically clamped to what ONE mutant is worth (coverage / mutant count), so killing
# a single mutant always counts as progress no matter how mutant-dense the method is.
MIN_ROUND_GAP_FRAC=0.05
MIN_ROUND_GAIN=0.5
# github = push branch + open real PR | local = record branch + patch + PR payload
PR_MODE=github
# Base branch for PRs (defaults to REPO_BRANCH).
PR_BASE=
# Extra build goal/task to run after the initial compile (e.g. a codegen step).
SETUP_SCRIPT=
DRY_RUN=false

# ─── Java toolchain ─────────────────────────────────────────────────────────
# PIT and its engine bridges. PIT_MUTATORS=ALL surfaces more mutation kinds (and
# more test ideas) at the cost of slower runs and more equivalent mutants.
PIT_VERSION=1.25.8
PIT_JUNIT5_VERSION=1.2.3
PIT_TESTNG_VERSION=1.0.0
PIT_MUTATORS=DEFAULTS
# method = each improvement round mutates only the method it targets (PIT cost is
# mutants x suite time, so a class-wide run per round dominates wall-clock); the class
# score is projected between rounds and measured for real once at the end.
# class = mutate the whole class every round (slower, no projection).
PIT_SCOPE=method
# classes with fewer mutants than this are skipped without consuming the file quota
MIN_MUTANTS_PER_CLASS=3
# a method with fewer executable lines than this is not worth a run (accessors,
# one-line private constructors)
# The coverage phase runs only for a method covered at or below this (0 = only methods
# nothing executes at all). Above it the mutation phase raises coverage on its own,
# because killing a NO_COVERAGE mutant means executing the line it sits on.
COV_PHASE_MAX_PCT=0
MIN_UNIT_LINES=2
# units we could not MEASURE do not consume the scope quota; this bounds how many
# such failures a run tolerates before concluding the repo/toolchain is at fault
MAX_FAILURES=10
JACOCO_VERSION=0.8.12
# Maven mirror for the Gradle PIT plugin resolution (Nexus group repo by default).
MAVEN_MIRROR_URL=http://nexus:8081/repository/maven-public/

# ─── Team rules, applied at every stage (free text, LLM-interpreted) ───────
RULES_POST_CLONE=read AGENTS.md to find out how to behave after cloning
RULES_PRE_PICK=create a separate branch per class named tests/improve-{file}
RULES_PICK_FILE=pick the class with the weakest tests; prefer logic-dense classes over DTOs and generated code
RULES_WRITE_TEST=don't use reflection or introspection; follow the existing test style
RULES_CHECK_CHANGES=changes are good only if MAC improved and the suite is green
RULES_MAKE_PR=read AGENTS.md to find out how to make the PR properly

# ─── LLM (OpenAI-compatible /v1) ────────────────────────────────────────────
LLM_BASE_URL=https://inference.mikhailov.tech/qwen-3.6-27b-fp8/v1
LLM_API_KEY=sk-replace_me
LLM_MODEL=qwen-3.6-27b-fp8
LLM_CONTEXT_LENGTH=32768
LLM_ENABLE_THINKING=true
LLM_THINKING_BUDGET=3000

# ─── Services ───────────────────────────────────────────────────────────────
SIDECAR_PORT=3000
N8N_PORT=5678
N8N_OWNER_EMAIL=admin@ijt.local
# WEBHOOK/editor URLs for links in the n8n UI
WEBHOOK_URL=https://improve-java-tests-n8n.mikhailov.tech/
N8N_EDITOR_BASE_URL=https://improve-java-tests-n8n.mikhailov.tech/
